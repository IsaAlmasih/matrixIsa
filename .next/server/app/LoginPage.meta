{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/LoginPage/layout,_N_T_/LoginPage/page,_N_T_/LoginPage"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/LoginPage/__PAGE__",
    "/LoginPage",
    "/_index",
    "/_head"
  ]
}